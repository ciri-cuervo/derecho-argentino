    },
    "normas_texto": {
      "tipo": "glob",
      "patron": "derecho/fuentes/normas/*.txt"
    },
    "docs": {
      "tipo": "glob",
      "patron": "docs/*.md"
    },
    "fallos": {
      "tipo": "json_largo",
      "archivo": "derecho/fuentes/jurisprudencia/fallos.json",
      "clave": "fallos"
    },
    "perfiles_jurisdiccionales": {
      "tipo": "glob",
      "patron": "derecho/kb/jurisdicciones/administrativo/*.md"
    },
    "indice_danos": {
      "tipo": "renglones",
      "archivo": "derecho/skills/derecho-argentino/references/danos-indice-doctrinario.md",
      "patron": "^### ",
      "nota": "Las entradas por instituto son los encabezados de nivel 3 de la sección `Doctrina por instituto`. NO son las filas de las dos tablas del archivo, que son el índice de capítulos de la obra: contar esas daba 34 y llevaba a corregir una cifra que estaba bien."
    },
    "archivos_kb": {
      "tipo": "glob_excluye",
      "patron": "derecho/kb/**/*",
      "excluye": [
        ".*"
      ],
      "nota": "Los archivos de la capa 2. Es la misma cifra que frontera_kb.py fija por sha256 en kb-procedencia.json, y por eso se mueve solo cuando alguien decide moverla."
    },
    "mb_instalados": {
      "tipo": "megabytes",
      "carpeta": "derecho",
      "excluye": [
        "_local",
        "__pycache__"
      ],
      "nota": "Lo que pesa el plugin instalado. Saltea `_local/` -está en .gitignore-, los `__pycache__` que dejan los tests y todo lo que empieza con punto: nada de eso viaja en un checkout, y contarlo daba una cifra distinta en cada máquina."
    },
    "marcadores": {
      "tipo": "renglones",
      "archivo": "derecho/skills/derecho-argentino/references/marcadores.md",
      "patron": "^### [A-Z]\\d+ · ",
      "nota": "Un encabezado por marcador, con su serie. El SKILL.md dice cuántos son y su tabla agrupa los tres RED FLAG en una fila, así que la tabla tiene menos filas que marcadores hay."
    },
    "modelos_kb": {
      "tipo": "glob",
      "patron": "derecho/kb/**/modelos/*.md",
      "nota": "Los modelos de escrito de la capa 2, que `modelos.md` 23 mapea. Estaba escrito a mano en dos módulos y decían distinto: treinta y cinco en escritos.md y treinta y cuatro en modelos.md."
    }
  },
